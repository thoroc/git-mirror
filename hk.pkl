amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["cargo-fmt"] = Builtins.cargo_fmt
    ["cargo-clippy"] = Builtins.cargo_clippy
    ["shellcheck"] = Builtins.shellcheck
    // No builtin for Kingfisher; --staged scans the synthesized staged diff
    // (not the raw working tree), so it never needs .kingfisher-baseline.yml —
    // that file only suppresses pre-existing findings in git history, which
    // --staged doesn't look at.
    ["kingfisher"] {
        check = "kingfisher scan . --staged --quiet --no-update-check"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps {
            ["cargo-test"] {
                glob = "**/*.rs"
                check = "cargo test --workspace --all-features --quiet"
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["check-conventional-commit"] = Builtins.check_conventional_commit
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
